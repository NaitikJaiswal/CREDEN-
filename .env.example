# =======================================================
# CREDEN — Environment Configuration (.env.example)
# AICTE Student Identity, Data Verification & Academic Governance Platform
# =======================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS and public verification links)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# If MongoDB is unavailable or left as default, CREDEN automatically
# boots with its resilient In-Memory Database Engine with ~1,500 synthetic records.
MONGODB_URI=mongodb://127.0.0.1:27017/creden

# Security Secrets
JWT_SECRET=creden_secure_sih_jwt_secret_token_key_2026
JWT_EXPIRES_IN=24h
HMAC_SECRET=creden_apaar_identifier_salt_key_secure_2026

# SIH Prototype Demo Mode (Set to true to enable demo accounts and fixtures)
IS_DEMO_MODE=true

